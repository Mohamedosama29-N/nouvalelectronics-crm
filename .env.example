# Firebase project config (Project Settings > General > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Used to encrypt session data cached in localStorage (any long random string)
VITE_ENCRYPTION_KEY=

# Firebase Cloud Messaging Web Push certificate key pair
VITE_VAPID_KEY=

# ==========================================================================
# 🧾 الفاتورة الضريبية (ETA) - ملاحظة مهمة
# ==========================================================================
# مفاتيح ETA (Client ID / Secret) ما بتتحطش هنا أبدًا. الملف ده بيتقرأ من
# المتصفح (Vite)، وأي سر هنا بيبقى مكشوف لأي حد. المفاتيح دي بتتحط في
# Firebase Functions Secrets بدل كده:
#   firebase functions:secrets:set ETA_CLIENT_ID
#   firebase functions:secrets:set ETA_CLIENT_SECRET
# راجع ETA_EINVOICE.md لتفاصيل الإعداد الكامل.

