rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================================
    // 🔐 قواعد "الدخول الآمن المجاني" (VITE_AUTH_MODE=firebase) — مجانية على خطة Spark.
    // ⚠️ متنشرهاش غير بعد ما تتبع SECURE_LOGIN.md وكل الموظفين يتربطوا.
    // الفكرة: كل موظف عنده حساب Firebase Auth (إيميل/باسورد)، ومستند authLinks/{uid}
    // بيربطه بمستند الموظف. أي حد مش موظف مربوط (حتى لو دخل بحساب مجهول) ميقدرش يقرا
    // أو يكتب أي حاجة، والموظف الموقوف بيتقفل فورًا.
    // ==========================================================================

    function signedIn() { return request.auth != null && request.auth.token.get('email', '') != ''; }
    function linkPath() { return /databases/$(database)/documents/authLinks/$(request.auth.uid); }
    function linked() { return signedIn() && exists(linkPath()); }
    function emp() { return get(/databases/$(database)/documents/employees/$(get(linkPath()).data.employeeId)).data; }
    // الإيميل لازم يطابق كمان: لو إيميل الموظف اتغيّر، الحساب القديم بيتقفل تلقائي
    function isEmployee() { return linked() && emp().get('isDisabled', false) != true && emp().get('email', '') == request.auth.token.email; }
    function role() { return emp().get('role', ''); }
    function isAdmin() { return isEmployee() && role() == 'admin'; }
    function canManageUsers() { return isEmployee() && (isAdmin() || emp().get('permissions', {}).get('manageUsers', false) == true); }

    // الربط: الموظف بيربط حسابه بنفسه أول مرة بس، والإيميل لازم يطابق إيميل مستند الموظف
    match /authLinks/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && get(/databases/$(database)/documents/employees/$(request.resource.data.employeeId)).data.email == request.auth.token.email;
      allow delete: if isAdmin();
    }

    // الموظفين: الموظف قبل الربط يقدر يدوّر على مستنده هو بس (بالإيميل)
    match /employees/{userId} {
      allow list: if isEmployee() || (signedIn() && resource.data.email == request.auth.token.email);
      allow get: if isEmployee() || (signedIn() && resource.data.email == request.auth.token.email);
      allow create, delete: if canManageUsers() && (isAdmin() || request.resource.data.get('role', '') != 'admin');
      allow update: if isAdmin()
        || (canManageUsers() && request.resource.data.get('role', '') != 'admin' && resource.data.get('role', '') != 'admin')
        || (signedIn() && resource.data.email == request.auth.token.email
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'limits', 'isDisabled', 'assignedWarehouseId', 'email']));
    }

    match /api_keys/{id} { allow read, write: if isAdmin(); }
    match /login_history/{id} {
      allow create: if isEmployee();
      allow read: if isAdmin() || canManageUsers();
      allow update, delete: if false;
    }
    // سجل التعديلات: أي موظف يضيف، ومحدش يمسح، والتعديل (علامة "اترجع") للأدمن
    match /auditTrail/{id} {
      allow create, read: if isEmployee();
      allow update: if isAdmin() || (isEmployee() && emp().get('permissions', {}).get('revertChanges', false) == true);
      allow delete: if false;
    }
    match /einvoices/{id} { allow read: if isEmployee(); allow write: if false; }

    // صفحة "تابع تذكرتك": أي حد معاه التوكن يقرا مستند واحد بس
    // ⭐ تقييم العميل (مجاني): أي حد معاه التوكن يقرا مستند واحد ويقيّم مرة واحدة بس
    match /ticketRatings/{token} {
      allow get: if true;
      allow list: if isEmployee();
      allow create, delete: if isEmployee();
      allow update: if isEmployee() || (
        resource.data.rated == false && request.resource.data.rated == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rated', 'ratings', 'repurchase', 'comment', 'ratedAt'])
        && request.resource.data.ratings.keys().hasOnly(['accessibility', 'maintenanceTime', 'centerDealing', 'deliveryProcedures'])
        && request.resource.data.ratings.accessibility is int && request.resource.data.ratings.accessibility >= 1 && request.resource.data.ratings.accessibility <= 5
        && request.resource.data.ratings.maintenanceTime is int && request.resource.data.ratings.maintenanceTime >= 1 && request.resource.data.ratings.maintenanceTime <= 5
        && request.resource.data.ratings.centerDealing is int && request.resource.data.ratings.centerDealing >= 1 && request.resource.data.ratings.centerDealing <= 5
        && request.resource.data.ratings.deliveryProcedures is int && request.resource.data.ratings.deliveryProcedures >= 1 && request.resource.data.ratings.deliveryProcedures <= 5
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 500
        && request.resource.data.repurchase in ['yes', 'no', '']
        && request.resource.data.ratedAt == request.time);
    }

    // 📝 طلبات الصيانة من صفحة الحجز العامة: أي حد يقدر يضيف طلب بشروط، والقراءة للموظفين بس
    match /serviceRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'governorate', 'city', 'address', 'device', 'brand', 'issue', 'kind', 'preferredDate', 'source', 'status', 'createdAt'])
        && request.resource.data.status == 'new' && request.resource.data.createdAt == request.time
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.matches('^01[0125][0-9]{8}$')
        && request.resource.data.issue is string && request.resource.data.issue.size() <= 600
        && request.resource.data.address is string && request.resource.data.address.size() <= 200
        && request.resource.data.device is string && request.resource.data.device.size() <= 40
        && request.resource.data.kind in ['center', 'visit', 'inquiry'];
      allow read, update, delete: if isEmployee();
    }
    // إعدادات الصفحات العامة (من غير بيانات حساسة)
    match /publicConfig/{id} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    match /ticketTracking/{token} {
      allow get: if true;
      allow list: if false;
      allow write: if isEmployee();
    }

    match /{document=**} {
      allow read, write: if isEmployee();
    }
  }
}
